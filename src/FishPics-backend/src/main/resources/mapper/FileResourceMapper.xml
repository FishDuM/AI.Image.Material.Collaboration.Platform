        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="hk.ljx.fishpicsbackend.mapper.FileResourceMapper">

    <resultMap id="BaseResultMap" type="hk.ljx.fishpicsbackend.picture.entity.FileResource">
            <id property="id" column="id" />
