<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="hk.ljx.fishpicsbackend.mapper.UserFansMapper">

    <resultMap id="BaseResultMap" type="hk.ljx.fishpicsbackend.user.entity.UserFans">
            <result property="id" column="id" />
            <result property="userId" column="user_id" />
            <result property="fanId" column="fan_id" />
    </resultMap>

    <sql id="Base_Column_List">
        id,user_id,fan_id
    </sql>

    <select id="selectFansPage" resultType="hk.ljx.fishpicsbackend.user.vo.FollowUserVO">
        SELECT u.id, u.username, u.nickname, u.avatar, u.level
        FROM user_fans uf
        INNER JOIN user u ON uf.fan_id = u.id
        WHERE uf.user_id = #{userId}
        ORDER BY uf.id DESC
    </select>

    <select id="selectFollowsPage" resultType="hk.ljx.fishpicsbackend.user.vo.FollowUserVO">
        SELECT u.id, u.username, u.nickname, u.avatar, u.level
        FROM user_fans uf
        INNER JOIN user u ON uf.user_id = u.id
        WHERE uf.fan_id = #{userId}
        ORDER BY uf.id DESC
    </select>
</mapper>
